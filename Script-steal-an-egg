-- Funções
local function savePosition()
    local character = player.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    savedPosition = rootPart.Position
    statusLabel.Text = "✓ Posição salva em: " .. tostring(Vector3.new(
        math.floor(savedPosition.X),
        math.floor(savedPosition.Y),
        math.floor(savedPosition.Z)
    ))
    statusLabel.TextColor3 = Color3.fromRGB(81, 214, 133)
end

local function startFlying()
    if not savedPosition then
        statusLabel.Text = "✗ Salve uma posição antes"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    isFlying = true
    statusLabel.Text = "🛫 Voando para a posição..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
end

local function stopFlying()
    isFlying = false
    statusLabel.Text = "✓ Voo parado"
    statusLabel.TextColor3 = Color3.fromRGB(200, 210, 225)
end

-- Conexões dos botões
saveButton.MouseButton1Click:Connect(savePosition)
flyButton.MouseButton1Click:Connect(startFlying)
stopButton.MouseButton1Click:Connect(stopFlying)

speedUpButton.MouseButton1Click:Connect(function()
    flySpeed = math.min(flySpeed + 5, 100)
    speedLabel.Text = "Velocidade: " .. flySpeed
end)

speedDownButton.MouseButton1Click:Connect(function()
    flySpeed = math.max(flySpeed - 5, 5)
    speedLabel.Text = "Velocidade: " .. flySpeed
end)

-- Teclas de atalho
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F then
        savePosition()
    elseif input.KeyCode == Enum.KeyCode.G then
        startFlying()
    elseif input.KeyCode == Enum.KeyCode.H then
        stopFlying()
    elseif input.KeyCode == Enum.KeyCode.K then
        isGuiVisible = not isGuiVisible
        screenGui.Enabled = isGuiVisible
    end
end)

-- Loop do fly automático
RunService.RenderStepped:Connect(function()
    if not isFlying then return end
    
    local character = player.Character
    if not character then
        stopFlying()
        return
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        stopFlying()
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        stopFlying()
        return
    end
    
    if not savedPosition then
        stopFlying()
        return
    end
    
    -- Distância até o alvo
    local distance = (rootPart.Position - savedPosition).Magnitude
    
    if distance < 5 then
        -- Chegou ao destino
        isFlying = false
        statusLabel.Text = "✓ Chegou ao destino!"
        statusLabel.TextColor3 = Color3.fromRGB(81, 214, 133)
        return
    end
    
    -- Direção para o alvo
    local direction = (savedPosition - rootPart.Position).Unit
    
    -- Move o personagem na direção do alvo com velocidade constante
    rootPart.CFrame = rootPart.CFrame + direction * (flySpeed / 60)
    
    -- Mantém o personagem em pé
    if humanoid then
        humanoid:Move(direction)
    end
end)
